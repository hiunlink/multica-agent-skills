{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jeff/agent-workflow/task.schema.json",
  "title": "Multi-Agent Task Manifest",
  "type": "object",
  "required": ["schemaVersion", "task"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "task": {
      "type": "object",
      "required": ["id", "projectId", "authority", "contextBundles", "execution", "stages", "nodes", "environmentGates"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "authority": { "type": "object" },
        "contextBundles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "execution": {
          "type": "object",
          "required": ["authorizationPhrase"],
          "properties": {
            "authorizationPhrase": { "type": "string", "minLength": 1 },
            "reportLanguage": { "type": "string" },
            "scheduling": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": { "enum": ["stage-batch", "rolling-window"] },
                "pilotNode": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "maxParallel", "nodes"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "maxParallel": { "type": "integer", "minimum": 1 },
              "nodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "role", "dependsOn", "contextBundles", "owns", "excludes", "acceptance", "tests"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "role": { "enum": ["implementation", "integration", "review", "verification"] },
              "risk": { "enum": ["low", "medium", "high"] },
              "review": {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["receipt", "independent", "cross-model"] },
                  "batch": { "type": ["string", "null"] }
                }
              },
              "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "dependencyInputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["node", "requiredOutputs"],
                  "properties": {
                    "node": { "type": "string", "minLength": 1 },
                    "requiredOutputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                  }
                }
              },
              "contextBundles": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "owns": { "type": "array", "items": { "type": "string" } },
              "excludes": { "type": "array", "items": { "type": "string" } },
              "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "behavioralProofs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "scenario", "test", "mandatory"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "scenario": { "type": "string", "minLength": 1 },
                    "test": { "type": "string", "minLength": 1 },
                    "mandatory": { "type": "boolean" }
                  }
                }
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "command", "mandatory"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "command": { "type": "string", "minLength": 1 },
                    "mandatory": { "type": "boolean" }
                  }
                }
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "properties": {
            "bindToIntegrationCommit": { "type": "boolean" },
            "integrationReview": {
              "type": "object",
              "required": ["mode", "required"],
              "properties": {
                "mode": { "enum": ["none", "receipt", "independent", "cross-model"] },
                "required": { "type": "boolean" }
              }
            }
          }
        },
        "environmentGates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "mandatory"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "mandatory": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
