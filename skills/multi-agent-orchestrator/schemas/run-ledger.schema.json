{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jeff/agent-workflow/run-ledger.schema.json",
  "title": "Multi-Agent Run Ledger",
  "type": "object",
  "required": ["schemaVersion", "taskId", "executionManifest", "baseline", "integration", "nodes", "runs", "gates", "parent"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "executionManifest": { "type": "string", "minLength": 1 },
    "baseline": { "type": "object" },
    "integration": { "type": "object" },
    "nodes": { "type": "object" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runId", "nodeId", "outcome"],
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "nodeId": { "type": "string" },
          "outcome": {
            "type": ["string", "null"],
            "enum": ["integrated", "rejected", "blocked", "replaced", "cancelled", "failed", null]
          },
          "replacementRunId": { "type": "string" },
          "retryAuthorizationRef": { "type": "string" }
        }
      }
    },
    "inbox": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventId", "kind", "createdAt"],
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "runId": { "type": ["string", "null"] },
          "nodeId": { "type": ["string", "null"] },
          "payload": { "type": ["string", "null"] },
          "createdAt": { "type": "string" },
          "drainedAt": { "type": ["string", "null"] }
        }
      }
    },
    "retrospective": {
      "type": "object",
      "properties": {
        "evidence": { "type": "array", "items": { "type": "string" } },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["class", "scope", "decision", "evidence"],
            "properties": {
              "class": { "type": "string", "minLength": 1 },
              "scope": { "enum": ["engine", "project", "task", "product", "rejected"] },
              "decision": { "enum": ["accepted", "rejected", "backlog"] },
              "evidence": { "type": "string", "minLength": 1 },
              "enforcement": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "gates": { "type": "object" },
    "parent": {
      "type": "object",
      "required": ["computedStatus", "closeAuthorized"],
      "properties": {
        "computedStatus": { "enum": ["blocked", "review", "done"] },
        "closeAuthorized": { "type": "boolean" }
      }
    }
  }
}
