{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jeff/agent-workflow/project.schema.json",
  "title": "Multi-Agent Project Profile",
  "type": "object",
  "required": ["schemaVersion", "project", "repositories", "documents", "contextBundles", "commands", "adapters", "policy", "reporting"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["id", "root", "language"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "writable"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "writable": { "type": "boolean" }
        }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "contextBundles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "commands": { "type": "object", "additionalProperties": { "type": "string" } },
    "adapters": { "type": "object" },
    "policy": {
      "type": "object",
      "required": ["delegation"],
      "properties": {
        "delegation": {
          "type": "object",
          "required": ["maxParallel", "nestedDelegates", "automaticRetry", "failurePolicy"],
          "properties": {
            "maxParallel": { "type": "integer", "minimum": 1 },
            "nestedDelegates": { "const": false },
            "automaticRetry": { "const": false },
            "failurePolicy": { "const": "stop-and-ask" }
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "defaultMode": { "enum": ["receipt", "independent", "cross-model"] },
            "riskModes": {
              "type": "object",
              "required": ["low", "medium", "high"],
              "properties": {
                "low": { "enum": ["receipt", "independent", "cross-model"] },
                "medium": { "enum": ["receipt", "independent", "cross-model"] },
                "high": { "enum": ["receipt", "independent", "cross-model"] }
              }
            },
            "integrationReviewForRisk": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["low", "medium", "high"] }
            }
          }
        }
      }
    },
    "reporting": { "type": "object" }
  }
}
